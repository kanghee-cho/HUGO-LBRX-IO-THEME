{
  "name": "hugo-lbrx-io-theme",
  "version": "0.1.0",
  "description": "A literary Hugo theme for lbrx.io — books, editions, and fiction.",
  "private": true,
  "scripts": {
    "dev": "concurrently \"hugo server --disableFastRender\" \"npx tailwindcss -i ./assets/css/main.css -o ./assets/css/main.min.css --watch\"",
    "build": "hugo --minify && npx pagefind --site public",
    "css:build": "npx tailwindcss -i ./assets/css/main.css -o ./assets/css/main.min.css --minify"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.15",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "pagefind": "^1.3.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17"
  }
}
