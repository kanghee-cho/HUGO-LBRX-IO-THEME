{
  "name": "hugo-lbrx-io-theme",
  "version": "1.1.0",
  "description": "A literary Hugo theme for lbrx.io — books, editions, and fiction.",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "predev": "npm run css:build",
    "dev": "concurrently --kill-others-on-fail \"hugo server --source exampleSite --themesDir=.. --theme=. --disableFastRender\" \"npm run css:watch\"",
    "prebuild": "npm run css:build",
    "build": "hugo --source exampleSite --themesDir=.. --theme=. --minify && pagefind --site exampleSite/public",
    "css": "tailwindcss -i ./assets/css/main.css -o ./assets/css/main.min.css",
    "css:build": "npm run css -- --minify",
    "css:watch": "npm run css -- --watch",
    "test:css": "npm run css:build && node --test tests/css.test.cjs"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "concurrently": "^9.1.2",
    "pagefind": "^1.3.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.3.3"
  }
}
